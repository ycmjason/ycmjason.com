---
import FaceSticker from '../components/FaceSticker.astro';
import MarginNote from '../components/MarginNote.astro';
import Polaroid from '../components/Polaroid.astro';
import Stamp from '../components/Stamp.astro';
import StickyNote from '../components/StickyNote.astro';
import WashiTape from '../components/WashiTape.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const now = new Date();

const socials = [
  { name: 'GitHub', href: 'https://github.com/ycmjason', handle: '@ycmjason' },
  { name: 'X', href: 'https://x.com/ycmjason', handle: '@ycmjason' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/ycmjason/', handle: 'in/ycmjason' },
  { name: 'dev.to', href: 'https://dev.to/ycmjason', handle: '@ycmjason' },
  { name: 'YouTube', href: 'https://www.youtube.com/@YCMJasonCodes', handle: '@YCMJasonCodes' },
];
---

<BaseLayout>
  <main class="mx-auto max-w-[1180px] px-5 pt-16 pb-24 sm:px-8 md:pt-24">
    <!-- --- header / hero --- -->
    <header class="relative grid grid-cols-12 gap-6">
      <div class="col-span-12 md:col-span-7">
        <p class="font-hand text-2xl text-ink-soft">hello, internet.</p>
        <h1
          class="mt-2 font-display text-[clamp(3rem,8vw,6rem)] leading-[0.95] text-ink text-balance"
        >
          i'm <span class="highlighted">Jason</span>,<br>
          and this is <span class="font-display italic text-bubblegum-deep">my website.</span>
        </h1>
        <p class="mt-6 max-w-[52ch] text-pretty text-[1.075rem] leading-relaxed text-ink-soft">
          Principal frontend engineer in London, occasional tech speaker, full-time fan of
          TypeScript, half-decent at karaoke. I've been on the internet since dial-up, building for
          it since 2017, and I keep a corner of it here.
        </p>
      </div>

      <div class="relative col-span-12 md:col-span-5">
        <div class="relative mx-auto w-fit md:ml-auto">
          <WashiTape
            rotate={6}
            width={140}
            class="absolute -top-3 left-1/2 z-10 -translate-x-1/2"
          />
          <Polaroid
            src="/profile.webp"
            alt="Jason on stage at Vue.js London, with a code projection behind him"
            caption="vue.js london, 2019 ✏️"
            rotate={-3}
            width={280}
          />
          <span class="absolute -top-3 -left-16 z-20">
            <Stamp text="PROFESSIONAL" rotate={-15} />
          </span>
        </div>
      </div>

      <FaceSticker
        mood="neutral"
        size={72}
        rotate={-14}
        autoWiggle
        class="absolute -top-6 left-[42%] hidden md:block"
      />
    </header>

    <!-- --- today's entry --- -->
    <section class="relative mt-24">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-8 md:col-start-2">
          <div class="flex items-baseline gap-3">
            <h2 class="font-display text-3xl text-ink">Today's entry</h2>
            <span class="font-hand text-xl text-ink-faint">· what i'm up to</span>
          </div>
          <div class="mt-5 space-y-4 text-pretty leading-relaxed text-ink-soft">
            <p>
              Currently building frontend things at
              <a
                href="https://boltzbit.com"
                target="_blank"
                rel="noopener noreferrer"
                class="link-pen text-ink hover:link-pen-hover"
              >
                Boltzbit
              </a>, leading the architecture of an AI-empowered app builder. Most days I'm somewhere
              between a TypeScript compiler error and a strong opinion about state management.
            </p>
            <p>
              Outside of that: writing about <span class="highlighted">dev tools</span>, shipping
              the occasional open-source thing, and speaking at conferences when they'll have me. I
              once made a mobile app that hit
              <strong class="font-display text-ink">14k+</strong>
              downloads, and I haven't shut up about it since.
            </p>
          </div>
        </div>

        <div class="col-span-12 mt-2 md:col-span-3 md:col-start-10 md:mt-0 md:block md:self-center">
          <MarginNote rotate={-8} arrow="left">
            this is the bit where i pretend to be humble
          </MarginNote>
        </div>
      </div>
    </section>

    <!-- --- pinned things --- -->
    <section class="relative mt-28">
      <div class="mb-10 flex items-end gap-4">
        <h2 class="font-display text-3xl text-ink">Pinned things</h2>
        <span class="font-hand text-xl text-ink-faint">· pages worth a click</span>
        <FaceSticker mood="happy" size={64} rotate={10} class="ml-2 hidden sm:inline-block" />
      </div>

      <div class="relative grid grid-cols-12 gap-x-6 gap-y-10">
        <!-- The Diary — featured, large -->
        <div class="relative col-span-12 md:col-span-7">
          <WashiTape rotate={-8} width={130} class="absolute -top-3 left-10 z-10" />
          <WashiTape rotate={8} width={110} pattern="dot" class="absolute -top-3 right-12 z-10" />
          <StickyNote
            href="https://diary.ycmjason.com"
            external
            tone="pink"
            rotate={-1.5}
            size="lg"
            class="block"
          >
            <p class="font-hand text-2xl text-ink-soft">new ✨ · the experiment</p>
            <h3 class="mt-1 font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-tight text-ink">
              diary.ycmjason.com
            </h3>
            <p class="mt-3 max-w-[42ch] text-pretty leading-relaxed text-ink-soft">
              An AI diary inspired by Tom Riddle's. Write in it, and a model trained on me will
              write back in my voice. Equal parts narcissism and engineering exercise.
            </p>
            <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-faint">
              open in new tab →
            </p>
          </StickyNote>
        </div>

        <!-- CV -->
        <div class="relative col-span-12 sm:col-span-6 md:col-span-5">
          <WashiTape rotate={12} width={100} class="absolute -top-3 left-6 z-10" />
          <StickyNote href="/cv" tone="cream" rotate={2.5} size="md" class="block h-full">
            <FaceSticker mood="thinking" size={56} rotate={-10} class="absolute -top-7 right-3" />
            <p class="font-hand text-xl text-ink-soft">the serious page</p>
            <h3 class="mt-1 font-display text-2xl leading-tight text-ink">Curriculum Vitae</h3>
            <p class="mt-3 text-pretty leading-relaxed text-ink-soft">
              Eight years of frontend, in a one-pager. Print-friendly, recruiter-friendly, PDF
              available.
            </p>
            <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-faint">/cv →</p>
          </StickyNote>
        </div>

        <!-- Talks -->
        <div class="relative col-span-12 sm:col-span-6 md:col-span-5 md:col-start-2">
          <WashiTape rotate={-10} width={100} class="absolute -top-3 left-8 z-10" />
          <StickyNote href="/cv#public-speaking" tone="pink" rotate={-1.5} class="block h-full">
            <p class="font-hand text-xl text-ink-soft">i talk, occasionally</p>
            <h3 class="mt-1 font-display text-2xl leading-tight text-ink">Talks &amp; meetups</h3>
            <p class="mt-3 text-pretty leading-relaxed text-ink-soft">
              Vue.js London, Manchester Web, Vue.js Slovenia. Five recorded talks, mostly about
              reactivity and the joy of small primitives.
            </p>
            <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-faint">
              /cv#public-speaking →
            </p>
          </StickyNote>
        </div>

        <!-- Articles -->
        <div class="relative col-span-12 sm:col-span-6 md:col-span-5">
          <StickyNote
            href="https://dev.to/ycmjason"
            external
            tone="yellow"
            rotate={2}
            class="block h-full"
          >
            <p class="font-hand text-xl text-ink-soft">scribbles</p>
            <h3 class="mt-1 font-display text-2xl leading-tight text-ink">Articles on dev.to</h3>
            <p class="mt-3 text-pretty leading-relaxed text-ink-soft">
              Notes from the trenches. TypeScript, monorepos, the occasional rant about tooling.
            </p>
          </StickyNote>
        </div>

        <!-- GitHub -->
        <div class="relative col-span-12 sm:col-span-6 md:col-span-5 md:col-start-4">
          <WashiTape rotate={-6} width={90} class="absolute -top-3 right-12 z-10" pattern="dot" />
          <StickyNote
            href="https://github.com/ycmjason"
            external
            tone="sky"
            rotate={1.5}
            class="block h-full"
          >
            <p class="font-hand text-xl text-ink-soft">where the code lives</p>
            <h3 class="mt-1 font-display text-2xl leading-tight text-ink">GitHub · @ycmjason</h3>
            <p class="mt-3 text-pretty leading-relaxed text-ink-soft">
              Open-source experiments, dev tools, and the occasional hot take committed at 2am.
            </p>
          </StickyNote>
        </div>
      </div>
    </section>

    <!-- --- find me elsewhere --- -->
    <section class="relative mt-28">
      <div class="flex items-baseline gap-3">
        <h2 class="font-display text-3xl text-ink">Find me elsewhere</h2>
        <span class="font-hand text-xl text-ink-faint">· the usual suspects</span>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-7 gap-y-3 text-pretty">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex items-baseline gap-2 font-display text-lg text-ink hover:text-bubblegum-deep"
            >
              <span class="link-pen">{s.name}</span>
              <span class="font-hand text-base text-ink-faint">{s.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- --- footer --- -->
    <footer class="relative mt-32 border-t border-dashed border-ink/20 pt-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <p class="font-hand text-xl text-ink-soft">made in hong kong, shaped in london 💖</p>
        <p class="font-mono text-xs uppercase tracking-widest text-ink-faint">
          © {now.getFullYear()} · Jason Yu
        </p>
      </div>
      <FaceSticker mood="surprised" size={64} rotate={18} class="absolute -top-2 right-1/3" />
    </footer>
  </main>
</BaseLayout>
