---
type Mood = 'neutral' | 'happy' | 'surprised' | 'thinking';
interface Props {
  mood: Mood;
  size?: number;
  rotate?: number;
  class?: string;
  alt?: string;
  wiggle?: boolean;
}
const { mood, size = 96, rotate = -6, class: cls = '', alt, wiggle = true } = Astro.props;
const labels: Record<Mood, string> = {
  neutral: 'Jason, deadpan',
  happy: 'Jason, grinning',
  surprised: 'Jason, agape',
  thinking: 'Jason, pondering',
};
---

<span
  class={`face-sticker inline-block ${wiggle ? 'wiggle' : ''} ${cls}`}
  style={`--rot: ${rotate}deg; --size: ${size}px; transform: rotate(var(--rot));`}
  aria-hidden={!alt ? 'true' : undefined}
>
  <img
    src={`/stickers/${mood}.png`}
    alt={alt ?? labels[mood]}
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    style={`width: var(--size); height: auto;`}
  >
</span>

<style>
.face-sticker {
  filter: drop-shadow(0 0 0 #fff8f6) drop-shadow(2px 0 0 #fff8f6) drop-shadow(-2px 0 0 #fff8f6)
    drop-shadow(0 2px 0 #fff8f6) drop-shadow(0 -2px 0 #fff8f6)
    drop-shadow(3px 5px 4px color-mix(in oklch, var(--color-ink) 35%, transparent));
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  transform-origin: 50% 90%;
}
:global(.dark) .face-sticker {
  filter: drop-shadow(0 0 0 #f7eee3) drop-shadow(2px 0 0 #f7eee3) drop-shadow(-2px 0 0 #f7eee3)
    drop-shadow(0 2px 0 #f7eee3) drop-shadow(0 -2px 0 #f7eee3)
    drop-shadow(3px 5px 6px rgba(0, 0, 0, 0.6));
}
.face-sticker.wiggle:hover {
  transform: rotate(calc(var(--rot) + 8deg)) scale(1.08);
  animation: wiggle 600ms cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes wiggle {
  0% {
    transform: rotate(calc(var(--rot) + 0deg)) scale(1.08);
  }
  25% {
    transform: rotate(calc(var(--rot) + 12deg)) scale(1.08);
  }
  55% {
    transform: rotate(calc(var(--rot) - 6deg)) scale(1.08);
  }
  100% {
    transform: rotate(calc(var(--rot) + 8deg)) scale(1.08);
  }
}
@media (prefers-reduced-motion: reduce) {
  .face-sticker,
  .face-sticker.wiggle:hover {
    transition: none;
    animation: none;
    transform: rotate(var(--rot));
  }
}
</style>
