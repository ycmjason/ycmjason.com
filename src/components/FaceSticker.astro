---
type Mood = 'neutral' | 'happy' | 'surprised' | 'thinking';
interface Props {
  mood: Mood;
  size?: number;
  rotate?: number;
  class?: string;
  alt?: string;
  wiggle?: boolean;
  /** Play the wiggle once on mount as a small "hello" gesture. */
  autoWiggle?: boolean;
  /** Delay (ms) before the auto-wiggle fires. */
  autoWiggleDelay?: number;
}
const {
  mood,
  size = 96,
  rotate = -6,
  class: cls = '',
  alt,
  wiggle = true,
  autoWiggle = false,
  autoWiggleDelay = 600,
} = Astro.props;
const decorative = !alt;
---

<span
  class={`face-sticker inline-block ${wiggle ? 'wiggle' : ''} ${cls}`}
  style={`--rot: ${rotate}deg; --size: ${size}px; transform: rotate(var(--rot));`}
  data-auto-wiggle={autoWiggle ? '' : undefined}
  data-auto-wiggle-delay={autoWiggle ? autoWiggleDelay : undefined}
  aria-hidden={decorative ? 'true' : undefined}
>
  <img
    src={`/stickers/${mood}.webp`}
    alt={decorative ? '' : alt}
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    style={`width: var(--size); height: auto;`}
  >
</span>

<script>
// One wiggle mechanism: add the .wiggling class, animation plays, animationend
// removes it. Spam-clickable because every trigger first removes the class and
// forces a reflow, so the animation restarts from frame 0 even if mid-flight.
const trigger = (el: HTMLElement) => {
  el.classList.remove('wiggling');
  void el.offsetWidth; // flush style so re-adding the class restarts the animation
  el.classList.add('wiggling');
};

for (const el of document.querySelectorAll<HTMLElement>('.face-sticker.wiggle')) {
  el.addEventListener('pointerdown', () => trigger(el));
  el.addEventListener('animationend', () => el.classList.remove('wiggling'));

  if (el.hasAttribute('data-auto-wiggle')) {
    const delay = Number(el.dataset.autoWiggleDelay ?? 600);
    setTimeout(() => trigger(el), delay);
  }
}
</script>

<style>
.face-sticker {
  filter: drop-shadow(0 0 0 #fff8f6) drop-shadow(2px 0 0 #fff8f6) drop-shadow(-2px 0 0 #fff8f6)
    drop-shadow(0 2px 0 #fff8f6) drop-shadow(0 -2px 0 #fff8f6)
    drop-shadow(3px 5px 4px color-mix(in oklch, var(--color-ink) 35%, transparent));
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  transform-origin: 50% 90%;
}
:global(.dark) .face-sticker {
  filter: drop-shadow(0 0 0 #f7eee3) drop-shadow(2px 0 0 #f7eee3) drop-shadow(-2px 0 0 #f7eee3)
    drop-shadow(0 2px 0 #f7eee3) drop-shadow(0 -2px 0 #f7eee3)
    drop-shadow(3px 5px 6px rgba(0, 0, 0, 0.6));
}
/* Mouse-only tilt feedback. The full wiggle is reserved for click/tap so
   hover and click never animate at the same time. */
.face-sticker.wiggle:hover {
  transform: rotate(calc(var(--rot) + 6deg)) scale(1.05);
}
/* Single wiggle animation, triggered by JS adding .wiggling. Spam-clickable
   because the JS removes the class and forces a reflow before re-adding. */
.face-sticker.wiggling {
  animation: wiggle-once 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes wiggle-once {
  0% {
    transform: rotate(var(--rot)) scale(1);
  }
  25% {
    transform: rotate(calc(var(--rot) + 14deg)) scale(1.06);
  }
  55% {
    transform: rotate(calc(var(--rot) - 8deg)) scale(1.06);
  }
  80% {
    transform: rotate(calc(var(--rot) + 5deg)) scale(1.03);
  }
  100% {
    transform: rotate(var(--rot)) scale(1);
  }
}
@media (prefers-reduced-motion: reduce) {
  .face-sticker,
  .face-sticker.wiggle:hover,
  .face-sticker.wiggling {
    transition: none;
    animation: none;
    transform: rotate(var(--rot));
  }
}
</style>
