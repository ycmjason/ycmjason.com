---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'CV — Jason Yu',
  description = "Jason Yu's CV. Principal Frontend Engineer, London.",
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <slot />
</BaseLayout>

<style is:global>
/* --- screen rendering of the CV: diary-flavored but readable --- */
.cv-md {
  max-width: 70ch;
  margin-inline: auto;
  color: var(--color-ink);
  font-family: var(--font-body);
  line-height: 1.65;
}

.cv-md h1 {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 4rem);
  line-height: 1;
  margin-block: 0 0.25em;
  color: var(--color-ink);
}
.cv-md h2 {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, 2rem);
  line-height: 1.15;
  margin-block: 2.5rem 0.75rem;
  color: var(--color-ink);
  border-bottom: 2px dashed color-mix(in oklch, var(--color-ink) 25%, transparent);
  padding-bottom: 0.35em;
}
.cv-md h3 {
  font-family: var(--font-display);
  font-size: 1.25rem;
  margin-block: 1.5rem 0.25rem;
  color: var(--color-ink);
}
.cv-md h4 {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 1.05rem;
  margin-block: 1rem 0.25rem;
  color: var(--color-ink-soft);
}

.cv-md p {
  margin-block: 0.6rem;
}
.cv-md blockquote {
  border-left: 3px solid var(--color-bubblegum);
  padding: 0.4rem 0 0.4rem 1rem;
  margin: 1.25rem 0;
  font-style: italic;
  color: var(--color-ink-soft);
}
.cv-md ul {
  list-style: none;
  padding-left: 1.25rem;
}
.cv-md ul li {
  position: relative;
  margin: 0.35rem 0;
}
.cv-md ul li::before {
  content: "✦";
  position: absolute;
  left: -1.25rem;
  color: var(--color-bubblegum);
  font-size: 0.9em;
  top: 0.1em;
}
.cv-md ul ul li::before {
  content: "–";
  color: var(--color-ink-faint);
}
.cv-md strong {
  color: var(--color-ink);
  font-weight: 700;
  background-image: linear-gradient(
    transparent 60%,
    color-mix(in oklch, var(--color-highlighter) 60%, transparent) 60%,
    color-mix(in oklch, var(--color-highlighter) 60%, transparent) 92%,
    transparent 92%
  );
  padding: 0 0.05em;
}
.cv-md a {
  color: var(--color-ink);
  background-image: linear-gradient(
    transparent 78%,
    color-mix(in oklch, var(--color-bubblegum) 80%, transparent) 78%,
    color-mix(in oklch, var(--color-bubblegum) 80%, transparent) 95%,
    transparent 95%
  );
  transition: background-color 200ms ease-out;
}
.cv-md a:hover {
  background-color: color-mix(in oklch, var(--color-bubblegum) 25%, transparent);
}
.cv-md code {
  font-family: var(--font-mono);
  font-size: 0.92em;
  background: var(--color-paper-shade);
  padding: 0.05em 0.35em;
  border-radius: 3px;
}

.cv-md .social-links {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin: 1.25rem 0;
}
.cv-md .button {
  display: inline-block;
  padding: 0.4rem 0.9rem;
  border: 1.5px solid var(--color-ink);
  background: var(--color-paper-shade);
  color: var(--color-ink);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background-image: none;
  transition: transform 180ms ease-out;
}
.cv-md .button:hover {
  transform: translate(-1px, -1px);
  box-shadow: 2px 2px 0 var(--color-ink);
  background: var(--color-bubblegum-soft);
}
.cv-md .print-only {
  display: none;
}

/* --- PRINT: strip everything, force light, classic CV --- */
@media print {
  :root,
  :root.dark {
    color-scheme: light !important;
    --color-paper: #ffffff !important;
    --color-paper-shade: #ffffff !important;
    --color-paper-edge: #ffffff !important;
    --color-ink: #111111 !important;
    --color-ink-soft: #222222 !important;
    --color-ink-faint: #555555 !important;
    --color-bubblegum: #111111 !important;
    --color-bubblegum-soft: transparent !important;
    --color-bubblegum-deep: #111111 !important;
    --color-highlighter: transparent !important;
  }
  html,
  body {
    background: #ffffff !important;
    color: #111111 !important;
  }
  body::before,
  body::after {
    display: none !important;
  }
  #theme-toggle,
  .print-hidden,
  .face-sticker,
  .washi-tape,
  .stamp {
    display: none !important;
  }
  .print-only {
    display: block !important;
  }
  .cv-md {
    max-width: none;
    margin: 0;
    font-size: 11pt;
    line-height: 1.45;
    color: #111 !important;
  }
  .cv-md h1 {
    font-size: 22pt;
  }
  .cv-md h2 {
    font-size: 14pt;
    margin-block: 1rem 0.4rem;
    border-bottom: 1px solid #000;
    padding-bottom: 0.15em;
  }
  .cv-md h3 {
    font-size: 12pt;
    margin-block: 0.8rem 0.15rem;
  }
  .cv-md strong {
    background: none !important;
    color: #000 !important;
  }
  .cv-md a {
    color: #111 !important;
    background: none !important;
    text-decoration: underline;
    text-decoration-color: #888;
  }
  .cv-md ul li::before {
    color: #000 !important;
  }
  .cv-md blockquote {
    border-color: #000;
    font-style: italic;
    color: #222 !important;
  }
  @page {
    margin: 0.6in 0.7in;
  }
}
</style>
