---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'CV — Jason Yu',
  description = "Jason Yu's CV. Principal Frontend Engineer — Hong Kong-born, London-based.",
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <slot />
</BaseLayout>

<style is:global>
/* The CV article uses @tailwindcss/typography `prose` for its baseline.
   Diary touches (highlighter on strong, dashed pink section borders,
   ✦ bullets, .button / .social-links from cv.md) are layered on top here. */

.cv-md {
  /* tighter than prose default to fit one page */
  --tw-prose-body: var(--color-ink-soft);
  --tw-prose-headings: var(--color-ink);
  --tw-prose-lead: var(--color-ink-soft);
  --tw-prose-links: var(--color-ink);
  --tw-prose-bold: var(--color-ink);
  --tw-prose-quotes: var(--color-ink-soft);
  --tw-prose-quote-borders: var(--color-bubblegum);
  --tw-prose-code: var(--color-ink);
  --tw-prose-counters: var(--color-ink-faint);
  --tw-prose-bullets: var(--color-bubblegum);
  --tw-prose-hr: color-mix(in oklch, var(--color-ink) 20%, transparent);
}

.cv-md h1,
.cv-md h2,
.cv-md h3 {
  font-family: var(--font-display);
  font-weight: 400;
}
.cv-md h2 {
  border-bottom: 2px dashed color-mix(in oklch, var(--color-ink) 25%, transparent);
  padding-bottom: 0.3em;
}
.cv-md strong {
  background-image: linear-gradient(
    transparent 60%,
    var(--color-highlighter) 60%,
    var(--color-highlighter) 92%,
    transparent 92%
  );
  padding: 0 0.05em;
}
/* In dark mode the cream text would sit poorly on a light yellow strip
   (both light), so swap the underline strip for a solid pink one — keeps
   the "marked" feel and reads fine against the cream text. */
:root.dark .cv-md strong {
  background-image: linear-gradient(
    transparent 60%,
    color-mix(in oklch, var(--color-bubblegum) 70%, transparent) 60%,
    color-mix(in oklch, var(--color-bubblegum) 70%, transparent) 92%,
    transparent 92%
  );
}
.cv-md a {
  background-image: linear-gradient(
    transparent 78%,
    color-mix(in oklch, var(--color-bubblegum) 80%, transparent) 78%,
    color-mix(in oklch, var(--color-bubblegum) 80%, transparent) 95%,
    transparent 95%
  );
  text-decoration: none;
  font-weight: inherit;
  transition: background-color 200ms ease-out;
}
.cv-md a:hover {
  background-color: color-mix(in oklch, var(--color-bubblegum) 25%, transparent);
}
.cv-md code {
  font-family: var(--font-mono);
  background: var(--color-paper-shade);
  padding: 0.05em 0.35em;
  border-radius: 3px;
  font-weight: inherit;
}
.cv-md code::before,
.cv-md code::after {
  content: none;
}
.cv-md blockquote {
  font-style: italic;
  font-weight: inherit;
  quotes: none;
}
.cv-md blockquote p::before,
.cv-md blockquote p::after {
  content: none;
}
/* swap default disc bullet for ✦ */
.cv-md ul {
  list-style: none;
  padding-left: 1.25rem;
}
.cv-md ul > li {
  position: relative;
}
.cv-md ul > li::before {
  content: "✦";
  position: absolute;
  left: -1.25rem;
  color: var(--color-bubblegum);
  font-size: 0.9em;
  top: 0.1em;
}
.cv-md ul ul > li::before {
  content: "–";
  color: var(--color-ink-faint);
}

/* sticky-note button styling for cv.md's <a class="button"> */
.cv-md .social-links {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin: 1.25rem 0;
}
.cv-md .button {
  display: inline-block;
  padding: 0.4rem 0.9rem;
  border: 1.5px solid var(--color-ink);
  background: var(--color-paper-shade);
  color: var(--color-ink);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background-image: none;
  transition: transform 180ms ease-out;
}
.cv-md .button:hover {
  transform: translate(-1px, -1px);
  box-shadow: 2px 2px 0 var(--color-ink);
  background: var(--color-bubblegum-soft);
}
.cv-md .print-only {
  display: none;
}

/* --- PRINT: strip everything, force light, classic CV --- */
@media print {
  :root,
  :root.dark {
    color-scheme: light !important;
    --color-paper: #ffffff !important;
    --color-paper-shade: #ffffff !important;
    --color-paper-edge: #ffffff !important;
    --color-ink: #111111 !important;
    --color-ink-soft: #222222 !important;
    --color-ink-faint: #555555 !important;
    --color-bubblegum: #111111 !important;
    --color-bubblegum-soft: transparent !important;
    --color-bubblegum-deep: #111111 !important;
    --color-highlighter: transparent !important;
  }
  html,
  body {
    background: #ffffff !important;
    color: #111111 !important;
  }
  body::before,
  body::after {
    display: none !important;
  }
  #theme-toggle,
  .print-hidden,
  .face-sticker,
  .washi-tape,
  .stamp {
    display: none !important;
  }
  .print-only {
    display: block !important;
  }
  main {
    padding: 0.3in !important;
    max-width: none !important;
    margin: 0 !important;
  }
  .cv-md {
    max-width: none !important;
    font-size: 11pt !important;
    line-height: 1.45 !important;
  }
  .cv-md h2 {
    border-bottom: 1px solid #000 !important;
  }
  .cv-md strong {
    background: none !important;
    color: #000 !important;
  }
  .cv-md a {
    background: none !important;
    text-decoration: underline;
    text-decoration-color: #888;
  }
  @page {
    margin: 0;
  }
}
</style>
