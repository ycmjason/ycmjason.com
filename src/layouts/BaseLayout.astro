---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  /** Hide chrome (toggle, background grain) — used by the CV page for clean print. */
  bare?: boolean;
}

const {
  title = 'YCM Jason · Principal Frontend Engineer',
  description = "Jason Yu's personal corner of the internet. Principal frontend engineer, tech speaker, OSS contributor. Hong Kong-born, London-based.",
  bare = false,
} = Astro.props;

const canonicalImage = new URL('/og.jpg', Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    <link rel="icon" type="image/webp" href="/stickers/happy.webp">
    <link rel="apple-touch-icon" href="/stickers/happy.webp">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Eczar:wght@400;500;600;700;800&family=Gloock&family=JetBrains+Mono:wght@400;500;700&display=swap"
    >
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Eczar:wght@400;500;600;700;800&family=Gloock&family=JetBrains+Mono:wght@400;500;700&display=swap"
      media="print"
      onload="this.media='all'"
    >
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Eczar:wght@400;500;600;700;800&family=Gloock&family=JetBrains+Mono:wght@400;500;700&display=swap"
      >
    </noscript>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={canonicalImage}>
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1731">
    <meta property="og:image:height" content="909">
    <meta
      property="og:image:alt"
      content="A diary-page portrait of Jason Yu, Principal Frontend Engineer"
    >
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={canonicalImage}>
    <meta
      name="twitter:image:alt"
      content="A diary-page portrait of Jason Yu, Principal Frontend Engineer"
    >
    <title>{title}</title>
    <script is:inline>
    // Set theme + data-theme attr before paint. Wrapped in try/catch because
    // localStorage throws in some sandboxed contexts (private iframes etc.).
    (() => {
      let mode = 'system';
      try {
        mode = localStorage.getItem('theme') || 'system';
      } catch {}
      const root = document.documentElement;
      root.dataset.theme = mode;
      const dark =
        mode === 'dark' ||
        (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) root.classList.add('dark');

      // Auto-wiggle: only on the first page view of a session, not every nav.
      let wiggled = false;
      try {
        wiggled = sessionStorage.getItem('wiggled') === '1';
      } catch {}
      if (wiggled) root.classList.add('wiggled');
      else {
        try {
          sessionStorage.setItem('wiggled', '1');
        } catch {}
      }
    })();
    </script>
  </head>
  <body class={bare ? 'bare' : ''}>
    {!bare && <ThemeToggle />}
    <slot />
  </body>
</html>

<style is:global>
body.bare::before,
body.bare::after {
  display: none;
}

/* Theme toggle icon selection driven by data-theme on <html>. This means the
   correct icon is visible from first paint, before the toggle's own JS runs. */
#theme-toggle [data-icon] {
  display: none;
}
:root[data-theme="system"] #theme-toggle [data-icon="system"],
:root[data-theme="light"] #theme-toggle [data-icon="sun"],
:root[data-theme="dark"] #theme-toggle [data-icon="moon"],
/* fallback when no data-theme is set (e.g. JS off entirely) */
  :root:not([data-theme])
  #theme-toggle
  [data-icon="system"] {
  display: block;
}
</style>
