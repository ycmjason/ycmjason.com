---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  /** Hide chrome (toggle, background grain) — used by the CV page for clean print. */
  bare?: boolean;
}

const {
  title = 'YCM Jason — Principal Frontend Engineer',
  description = "Jason Yu's personal corner of the internet. Principal frontend engineer, tech speaker, OSS contributor, based in London.",
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <link rel="icon" type="image/png" href="/profile.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:image" content="/profile.png">
    <meta name="twitter:card" content="summary">
    <title>{title}</title>
    <script is:inline>
    (() => {
      const m = localStorage.getItem('theme') || 'system';
      const dark =
        m === 'dark' || (m === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) document.documentElement.classList.add('dark');
    })();
    </script>
  </head>
  <body class={bare ? 'bare' : ''}>
    {!bare && <ThemeToggle />}
    <slot />
  </body>
</html>

<style is:global>
body.bare::before,
body.bare::after {
  display: none;
}
</style>
